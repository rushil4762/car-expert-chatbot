# Allowed origins for the frontend.
# Include the Vite dev server origin so the browser can call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# NVIDIA API settings for the chatbot.
# Copy this file to .env and add your real key before running the backend.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
